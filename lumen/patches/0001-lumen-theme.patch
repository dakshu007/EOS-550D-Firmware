+#define LUMEN_VERSION "0.3.2"
+
+/* LUMEN boot logo "Focus Frame": the LUMEN wordmark inside amber
+ * autofocus brackets. Drawn only with solid fills and 1px lines,
+ * so it is pixel-exact on the 720x480 LCD. */
+
+/* a straight stroke `thick` pixels wide (offset horizontally) */
+static void lumen_stroke(int x1, int y1, int x2, int y2, int thick, int color)
+{
+    for (int d = -(thick / 2); d < thick - thick / 2; d++)
+    {
+        draw_line(x1 + d, y1, x2 + d, y2, color);
+    }
+}
+
+/* geometric wordmark, 288 x 56 px, 4 px strokes, top-left at (ox, oy) */
+static void lumen_wordmark(int ox, int oy, int color)
+{
+    /* L */
+    bmp_fill(color, ox -   2, oy -  2,  4, 60);
+    bmp_fill(color, ox -   2, oy + 54, 44,  4);
+    /* U */
+    bmp_fill(color, ox +  60, oy -  2,  4, 60);
+    bmp_fill(color, ox + 100, oy -  2,  4, 60);
+    bmp_fill(color, ox +  60, oy + 54, 44,  4);
+    /* M */
+    bmp_fill(color, ox + 122, oy -  2,  4, 60);
+    bmp_fill(color, ox + 162, oy -  2,  4, 60);
+    lumen_stroke(ox + 124, oy, ox + 144, oy + 32, 5, color);  /* diagonals 5 px: same visual weight as 4 px verticals */
+    lumen_stroke(ox + 144, oy + 32, ox + 164, oy, 5, color);
+    /* E */
+    bmp_fill(color, ox + 184, oy -  2,  4, 60);
+    bmp_fill(color, ox + 184, oy -  2, 44,  4);
+    bmp_fill(color, ox + 184, oy + 26, 38,  4);
+    bmp_fill(color, ox + 184, oy + 54, 44,  4);
+    /* N */
+    bmp_fill(color, ox + 246, oy -  2,  4, 60);
+    bmp_fill(color, ox + 286, oy -  2,  4, 60);
+    lumen_stroke(ox + 248, oy, ox + 288, oy + 56, 5, color);
+}
+
+/* four autofocus corner brackets around (175,109)-(546,260), 3 px strokes */
+static void lumen_focus_frame(int color)
+{
+    bmp_fill(color, 175, 109, 27,  3);  bmp_fill(color, 175, 109,  3, 25);  /* top left */
+    bmp_fill(color, 519, 109, 27,  3);  bmp_fill(color, 543, 109,  3, 25);  /* top right */
+    bmp_fill(color, 175, 257, 27,  3);  bmp_fill(color, 175, 235,  3, 25);  /* bottom left */
+    bmp_fill(color, 519, 257, 27,  3);  bmp_fill(color, 543, 235,  3, 25);  /* bottom right */
+    fill_circle(360, 110, 3, color);                                        /* focus point */
+}
+
+/* LUMEN brand block: focus frame, wordmark, tagline and credit */
+static void lumen_draw_brand()
+{
+    lumen_focus_frame(COLOR_ORANGE);
+    lumen_wordmark(216, 156, COLOR_WHITE);
+
+    bmp_printf(FONT(FONT_MED, COLOR_GRAY(60), COLOR_BLACK) | FONT_ALIGN_CENTER, 360, 278, "CUSTOM FIRMWARE  /  EOS 550D");
+
+    bmp_printf(FONT(FONT_MED, COLOR_GRAY(85), COLOR_BLACK) | FONT_ALIGN_CENTER, 360, 308, "by Dakshesh");
+}
+
