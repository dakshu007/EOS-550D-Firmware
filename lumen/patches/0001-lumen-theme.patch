+/* LUMEN boot logo: shown for 2 seconds every time the camera starts,
+ * on the normal (non-LiveView) screen. Prefs > LUMEN Boot Logo turns it off. */
+static CONFIG_INT("lumen.boot.logo", lumen_boot_logo, 1);
+
+static void lumen_draw_boot_logo()
+{
+    bmp_fill(COLOR_BLACK, 0, 0, 720, 480);
+    lumen_draw_brand();
+    bmp_printf(FONT(FONT_SMALL, COLOR_GRAY(50), COLOR_BLACK) | FONT_ALIGN_CENTER, 360, 455, "LUMEN %s", LUMEN_VERSION);
+}
+
+static int lumen_boot_logo_allowed()
+{
+    return lumen_boot_logo && DISPLAY_IS_ON && !lv && !RECORDING && !gui_menu_shown();
 }
 
+static void lumen_boot_logo_task()
+{
+    extern int ml_started;
+
+    /* wait until Magic Lantern has finished starting (settings are loaded by then) */
+    for (int i = 0; i < 150 && !ml_started; i++)
+    {
+        msleep(100);
+    }
+    if (!ml_started) return;
+
+    msleep(300);    /* let Canon finish drawing its first screen */
+    if (!lumen_boot_logo_allowed()) return;
+
+    /* Save Canon's screen into the idle (back) bitmap buffer, draw the logo
+     * on the real one, then copy Canon's screen back. Asking Canon to redraw
+     * at startup is not reliable on the 550D (the screen could stay blank
+     * until a button press), so we restore exactly what was there. */
+    BMP_LOCK(
+        bmp_idle_copy(0, 1);        /* real -> idle: save Canon's screen */
+        lumen_draw_boot_logo();     /* draws to the real buffer */
+    )
+    msleep(2000);
+
+    /* restore only if nothing else took over the screen meanwhile
+     * (menu, LiveView or recording draw their own screens) */
+    if (!gui_menu_shown() && !lv && !RECORDING)
+    {
+        BMP_LOCK( bmp_idle_copy(1, 1); )    /* idle -> real: Canon's screen back */
+    }
+}
+
+TASK_CREATE("lumen_logo_task", lumen_boot_logo_task, 0, 0x1e, 0x1000);
+
+static struct menu_entry lumen_prefs_menu[] =
+{
+    {
+        .name   = "LUMEN Boot Logo",
+        .priv   = &lumen_boot_logo,
+        .max    = 1,
+        .help   = "Show the LUMEN logo for 2 seconds when the camera starts.",
+    },
+};
+
+static void lumen_menuhelp_init()
+{
+    menu_add("Prefs", lumen_prefs_menu, COUNT(lumen_prefs_menu));
+}
+
+INIT_FUNC("lumen_menuhelp", lumen_menuhelp_init);
+
